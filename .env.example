# Absolute site URL used for canonical links, sitemap, RSS, OG, and JSON-LD.
# Defaults to https://pooya.website. Use the *.workers.dev URL until DNS moves.
# SITE_URL=https://freelance-site.example.workers.dev

# Contact form (/api/contact). Without RESEND_API_KEY, `npm run dev` logs each
# message to the server console instead of sending it; production returns 503.
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=Pooya's site <contact@pooya.website>

# Optional Cloudflare Turnstile spam check. Used only when both are set.
# The site key is public and inlined at build time; the secret stays on the server.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Admin (/admin): "Sign in with GitHub". Not needed for `npm run dev`, which has no
# sign-in. In production /admin returns 404 until the client ID and secret (or the
# Keystatic ones below, which are the fallback) and ADMIN_SESSION_SECRET are set.
# ADMIN_GITHUB_CLIENT_ID=Iv1.xxxxxxxx
# ADMIN_GITHUB_CLIENT_SECRET=xxxxxxxx
# ADMIN_SESSION_SECRET=at-least-32-random-characters
# ADMIN_GITHUB_LOGINS=PooyaNikbakht
# ADMIN_GITHUB_IDS=
# IP_HASH_SALT=

# Keystatic GitHub mode (the editor at /keystatic in production). Keystatic writes
# these into .env when it creates its GitHub App (see README, "Edit from anywhere").
# KEYSTATIC_STORAGE=github
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
